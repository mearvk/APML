#sleela 3.1
<< ApmlBus: routes envelopes between modules and the six strands. Every
   envelope is appended to the ApmlMessageLog first and only then placed in
   the receiver mailbox; if either step fails the send returns -1.

   Micro messaging: send, query, interrupt, poll. One sender, one receiver.
   Macro messaging: broadcast fans one statement out to all six strands under a
   single correlation id; ApmlExchange runs a multi-step agreement under one id.

   Agency guards enforced here:
   - kinds that change what a party will do (interrupt, offer, counter, ack,
     decline) are refused unless they name an actor and a reason;
   - a broadcast is refused unless it names an actor and a reason;
   - nothing is delivered without first being logged. >>
class ApmlBus {
  ApmlMessageLog log = new ApmlMessageLog();
  ApmlMessageKind kinds = new ApmlMessageKind();
  ApmlMailbox mb1 = new ApmlMailbox();
  ApmlMailbox mb2 = new ApmlMailbox();
  ApmlMailbox mb3 = new ApmlMailbox();
  ApmlMailbox mb4 = new ApmlMailbox();
  ApmlMailbox mb5 = new ApmlMailbox();
  ApmlMailbox mb6 = new ApmlMailbox();
  ApmlMailbox mb7 = new ApmlMailbox();
  ApmlMailbox mb8 = new ApmlMailbox();
  int nextCorr = 1000;
  int refusedGuard = 0;
  int refusedFull = 0;

  ApmlMessageLog getLog() { return log; }

  ApmlMailbox box(int p) {
    if (p == 1) { return mb1; }
    if (p == 2) { return mb2; }
    if (p == 3) { return mb3; }
    if (p == 4) { return mb4; }
    if (p == 5) { return mb5; }
    if (p == 6) { return mb6; }
    if (p == 7) { return mb7; }
    return mb8;
  }

  boolean validParty(int p) {
    if (p < 1) { return false; }
    if (p > 8) { return false; }
    return true;
  }

  boolean hasText(String s) {
    if (s == null) { return false; }
    if (s == "") { return false; }
    return true;
  }

  int newCorrelation() {
    nextCorr = nextCorr + 1;
    return nextCorr;
  }

  < The one path every envelope takes: guard, log, then deliver. >
  int deliver(int k, int sc, int f, int t, int c, int p, String tp, String b, String a, String r) {
    if (validParty(f) == false) { refusedGuard = refusedGuard + 1; return -1; }
    if (validParty(t) == false) { refusedGuard = refusedGuard + 1; return -1; }
    if (kinds.needsAccountableActor(k)) {
      if (hasText(a) == false) { refusedGuard = refusedGuard + 1; return -1; }
      if (hasText(r) == false) { refusedGuard = refusedGuard + 1; return -1; }
    }
    ApmlMailbox m = box(t);
    if (m.pending() >= m.capacity()) { refusedFull = refusedFull + 1; return -1; }
    int seq = log.append(k, sc, f, t, c, p, tp, b, a, r);
    if (seq < 0) { refusedFull = refusedFull + 1; return -1; }
    boolean urgent = false;
    if (k == 3) { urgent = true; }
    m.offer(seq, urgent);
    return seq;
  }

  < Micro: one-way notice. >
  int notice(int f, int t, String tp, String b, String a) {
    return deliver(9, 1, f, t, newCorrelation(), 0, tp, b, a, "");
  }

  < Micro: a question. Returns the correlation id the REPLY will carry, or -1. >
  int query(int f, int t, String tp, String a) {
    int c = newCorrelation();
    int s = deliver(2, 1, f, t, c, 0, tp, "", a, "");
    if (s < 0) { return -1; }
    return c;
  }

  < Micro: answer a query, reusing its correlation id. >
  int reply(int f, int t, int c, String tp, String b, String a) {
    return deliver(8, 1, f, t, c, 0, tp, b, a, "");
  }

  < Micro: priority message. Needs an actor and a reason or it is refused. >
  int interrupt(int f, int t, String tp, String b, String a, String r) {
    return deliver(3, 1, f, t, newCorrelation(), 9, tp, b, a, r);
  }

  < Micro: look at the next waiting sequence number without taking it, or -1. >
  int poll(int p) {
    ApmlMailbox m = box(p);
    return m.peek();
  }

  < Take the next waiting sequence number, interrupts first, or -1. >
  int receive(int p) {
    ApmlMailbox m = box(p);
    return m.take();
  }

  int pending(int p) {
    ApmlMailbox m = box(p);
    return m.pending();
  }

  << Macro: fan one notice out to all six strands under one correlation id.
     Returns the correlation id, or -1 if any delivery was refused. >>
  int broadcast(int f, String tp, String b, String a, String r) {
    if (hasText(a) == false) { refusedGuard = refusedGuard + 1; return -1; }
    if (hasText(r) == false) { refusedGuard = refusedGuard + 1; return -1; }
    int c = newCorrelation();
    int t = 1;
    int ok = 0;
    while (t <= 6) {
      if (deliver(9, 2, f, t, c, 0, tp, b, a, r) >= 0) { ok = ok + 1; }
      t = t + 1;
    }
    if (ok < 6) { return -1; }
    return c;
  }

  < Macro step used by ApmlExchange: a guarded envelope on an existing correlation. >
  int step(int k, int f, int t, int c, String tp, String b, String a, String r) {
    return deliver(k, 2, f, t, c, 0, tp, b, a, r);
  }

  int refusedByGuard() { return refusedGuard; }
  int refusedAsFull() { return refusedFull; }

  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter and setter pairs. Values are
     faithful to the real origin where publicly known; unknown values say
     unknown. Science rating 1 means an initial design proposal. >>
  String metaVersion = "0.1.0";
  int metaId = 104;
  String metaAuthor = "Max Rupplin (mearvk), owner text; drafted with Kiro";
  String metaDate = "2026-11-16";
  String metaCopyright = "MIT License, Copyright (c) 2026 Max Rupplin";
  String metaTrademark = "unknown";
  String metaCorporation = "unknown";
  String metaOrigin = "unknown";
  String metaBirthDate = "2026-11-16";
  int metaScienceRating = 1;
  String metaNationalSchedule = "none";

  String getVersion() { return metaVersion; }
  void setVersion(String v) { metaVersion = v; }
  int getId() { return metaId; }
  void setId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
}
