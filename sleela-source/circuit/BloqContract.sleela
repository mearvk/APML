#sleela 3.1
<< BloqContract: strand 2 takes only what APML has validated. >>
class BloqContract extends StageContract {
  int strand() { return 2; }
  String inputText() { return "validated APML descriptions from strand 1"; }
  String whyText() { return "generating from an unvalidated description would spread its errors into source code"; }
  String beforeText() { return "kind is APML and it arrived through APML"; }
  String afterText() { return "the description is consumed and fan-out generated Java files, each marked generated, go to Bodi"; }

  int admit(FileAnatomy a, CircuitProfile p) {
    if (a.kind != 1) { return 1; }
    return 0;
  }
}
