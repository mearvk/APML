#sleela 3.1
<< CircuitNode: one terminal of the six. It owns a contract, a queue and a
   per-tick capacity, and it keeps the counts that Kirchhoff current law is
   checked against:

     offered = refused + taken + waiting

   Refusals are counted by reason. Warnings are admitted files the contract
   flagged. Wait is measured in ticks from arrival to being taken. >>
class CircuitNode {
  int number = 0;
  String name = "";
  StageContract contract = null;
  FileQueue queue = new FileQueue();
  int capacity = 1;
  int offered = 0;
  int admitted = 0;
  int refused = 0;
  int[] refusedBy = new int[16];
  int warnings = 0;
  int taken = 0;
  int takenThisTick = 0;
  int waitSum = 0;
  int waitMax = 0;

  void setup(int n, String nm, StageContract c, int cap, int buf) {
    number = n;
    name = nm;
    contract = c;
    capacity = cap;
    queue.setCapacity(buf);
  }

  void startTick() { takenThisTick = 0; }

  < Offer one file. Returns 0 if queued, else the refusal reason. >
  int offer(int id, int tick, FileAnatomy a, CircuitProfile p) {
    offered = offered + 1;
    int r = contract.admit(a, p);
    if (r == 0) {
      if (queue.push(id, tick) == false) { r = 9; }
    }
    if (r != 0) {
      refused = refused + 1;
      refusedBy[r] = refusedBy[r] + 1;
      return r;
    }
    admitted = admitted + 1;
    if (contract.warn(a, p)) { warnings = warnings + 1; }
    return 0;
  }

  boolean canTake() {
    if (takenThisTick >= capacity) { return false; }
    if (queue.count() == 0) { return false; }
    return true;
  }

  int take(int tick) {
    int id = queue.pop();
    if (id < 0) { return -1; }
    takenThisTick = takenThisTick + 1;
    taken = taken + 1;
    int w = tick - queue.lastArrival();
    waitSum = waitSum + w;
    if (w > waitMax) { waitMax = w; }
    return id;
  }

  int free() { return queue.free(); }
  int waiting() { return queue.count(); }
  int peak() { return queue.peakCount(); }
  int refusedFor(int r) { return refusedBy[r]; }

  boolean kirchhoff() {
    if (offered != refused + taken + waiting()) { return false; }
    if (admitted != taken + waiting()) { return false; }
    return true;
  }

  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter and setter pairs. Values are
     faithful to the real origin where publicly known; unknown values say
     unknown. Science rating 1 means an initial design proposal. >>
  String metaVersion = "0.1.0";
  int metaId = 203;
  String metaAuthor = "Max Rupplin (mearvk), owner text; drafted with Kiro";
  String metaDate = "2026-11-16";
  String metaCopyright = "MIT License, Copyright (c) 2026 Max Rupplin";
  String metaTrademark = "unknown";
  String metaCorporation = "unknown";
  String metaOrigin = "unknown";
  String metaBirthDate = "2026-11-16";
  int metaScienceRating = 1;
  String metaNationalSchedule = "none";

  String getVersion() { return metaVersion; }
  void setVersion(String v) { metaVersion = v; }
  int getId() { return metaId; }
  void setId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
}
