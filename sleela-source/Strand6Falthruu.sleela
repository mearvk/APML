#sleela 3.1
<< Strand6Falthruu: initial design proposal for strand 6 of 6, Falthruu, the carrying through.
   Statements marked owner claim come from the owner site text or the owner
   chat descriptions. Everything else is a proposal by the drafter and is open
   to rejection. Source documents: docs/ENGINEERING-PRINCIPLES.md and
   analysis/APML-ANALYSIS.md. >>
class Strand6Falthruu {
  int number() { return 6; }
  String name() { return "Falthruu"; }
  String role() { return "the carrying through"; }
  String stage() { return "Producial, over time"; }
  String question() { return "When a change turns out to be needed, how does it reach everywhere it should have been?"; }
  String principle() { return "A late change should be applied to the whole system and its history as one act, and that act must be safe to attempt."; }
  String handOffText() { return "A change that has been carried through is recorded in the description, so strand 1 is true again and the loop closes."; }
  < The strand this one hands off to; strand 6 hands back to strand 1. >
  int handOffTo() { return 1; }
  < The strand this one faces when the strand is folded in the middle (proposal). >
  int pairedWith() { return 1; }

  int ownerClaimCount() { return 4; }
  String ownerClaim(int i) {
    String[] a = {
      "Falthruu connects what should have been across the system without returning to design or implementation.",
      "One change requirement can be propagated across the system and into prior commits, programmatically.",
      "A developer works at their own pace and style, then runs Falthruu when a redesign that should have been caught earlier turns up.",
      "It is safe to fall thru; no more traps in software."
    };
    return a[i];
  }

  int goalCount() { return 3; }
  String goal(int i) {
    String[] a = {
      "A late change reaches every place it should.",
      "The change can be previewed, tested and undone.",
      "History already shared with others is not rewritten under them."
    };
    return a[i];
  }

  int procedureCount() { return 3; }
  String procedure(int i) {
    String[] a = {
      "Preview the change before applying it.",
      "Run the checks after applying it.",
      "Keep a way to undo it."
    };
    return a[i];
  }

  int signalInCount() { return 2; }
  String signalIn(int i) {
    String[] a = {
      "A change requirement stated against the description (strand 1).",
      "A drift report from Runyn (strand 5)."
    };
    return a[i];
  }

  int signalOutCount() { return 2; }
  String signalOut(int i) {
    String[] a = {
      "An updated description (strand 1).",
      "Regeneration requests to Bloq (strand 2) and mapping changes to Bodi (strand 3)."
    };
    return a[i];
  }

  int agencyGuardCount() { return 3; }
  String agencyGuard(int i) {
    String[] a = {
      "Principle of Safe Change: every system-wide change can be previewed, tested and undone.",
      "Prefer new commits that apply a change to older lines over rewriting history others have pulled.",
      "No change is applied without a named human approver."
    };
    return a[i];
  }

  int implementationCount() { return 3; }
  String implementation(int i) {
    String[] a = {
      "A change-requirement file format referencing description elements.",
      "A preview mode that lists every file and commit affected.",
      "An undo record stored with each applied change."
    };
    return a[i];
  }

  int openItemCount() { return 2; }
  String openItem(int i) {
    String[] a = {
      "Whether history is rewritten or extended is not stated.",
      "What safe guarantees in practice is not stated."
    };
    return a[i];
  }

  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter and setter pairs. Values are
     faithful to the real origin where publicly known; unknown values say
     unknown. Science rating 1 means an initial design proposal with nothing
     built yet. >>
  String metaVersion = "0.1.0";
  int metaId = 6;
  String metaAuthor = "Max Rupplin (mearvk), owner text; drafted with Kiro";
  String metaDate = "2026-11-16";
  String metaCopyright = "MIT License, Copyright (c) 2026 Max Rupplin";
  String metaTrademark = "unknown";
  String metaCorporation = "unknown";
  String metaOrigin = "unknown";
  String metaBirthDate = "2026-11-16";
  int metaScienceRating = 1;
  String metaNationalSchedule = "none";

  String getVersion() { return metaVersion; }
  void setVersion(String v) { metaVersion = v; }
  int getId() { return metaId; }
  void setId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
}
